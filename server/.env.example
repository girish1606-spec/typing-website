# ==============================================================================
# TYPE SPEED — Production Environment Configuration Example
# Copy this file to .env and fill in your actual production values.
# NEVER commit your actual .env file with sensitive production secrets.
# ==============================================================================

PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/type-speed

# JWT Authentication Secret (Use a cryptographically secure 256-bit key in production)
JWT_SECRET=typespeed_jwt_super_secure_production_secret_key_change_me_in_prod

# Developer / Admin Credentials (Used for secure Developer Sign In & Creation)
DEVELOPER_EMAIL=girish@gmail.com
DEVELOPER_PASSWORD=1234567890
DEVELOPER_NAME=Girish
DEVELOPER_SECRET_KEY=DEV_ADMIN_SECRET_2025

# Payment Integration (UPI & QR)
UPI_ID=typespeed@upi
UPI_MERCHANT_NAME=TYPE SPEED
QR_CODE_URL=

# External Payment Provider Keys (e.g. Razorpay / Cashfree / Stripe - optional for manual UPI flow)
PAYMENT_PROVIDER_KEY=rzp_test_placeholder_key
PAYMENT_PROVIDER_SECRET=rzp_test_placeholder_secret

# Frontend App URL for CORS and Redirects
APP_ORIGIN=http://localhost:5173
